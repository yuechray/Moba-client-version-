/* ── Root ───────────────────────────────────────────────────────── */
#root {
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
}

/* ── Panel card ─────────────────────────────────────────────────── */
.panel {
    width: 380px;
    background-color: rgb(245, 245, 250);
    border-radius: 14px;
    border-width: 1px;
    border-color: rgb(200, 200, 220);
    padding: 48px 40px;
    align-items: stretch;
}

/* ── Logo ───────────────────────────────────────────────────────── */
.logo {
    font-size: 52px;
    -unity-font-style: bold;
    color: rgb(30, 90, 200);
    -unity-text-align: middle-center;
    margin-bottom: 8px;
    letter-spacing: 4px;
}

/* ── Subtitle ───────────────────────────────────────────────────── */
.subtitle {
    font-size: 15px;
    color: rgb(80, 80, 110);
    -unity-text-align: middle-center;
    margin-bottom: 32px;
    white-space: normal;
}

/* ── Text field ─────────────────────────────────────────────────── */
.field {
    height: 46px;
    margin-bottom: 8px;
    border-radius: 8px;
    border-width: 1px;
    border-color: rgb(180, 180, 210);
    background-color: rgb(255, 255, 255);
    padding: 0 12px;
    font-size: 16px;
    color: rgb(20, 20, 40);
}

.field > .unity-text-element {
    color: rgb(20, 20, 40);
}

/* ── Error text ─────────────────────────────────────────────────── */
.error {
    height: 20px;
    font-size: 13px;
    color: rgb(200, 40, 40);
    -unity-text-align: middle-center;
    margin-bottom: 8px;
    white-space: normal;
}

/* ── Primary button ─────────────────────────────────────────────── */
.btn-primary {
    height: 50px;
    margin-top: 8px;
    border-radius: 10px;
    border-width: 0;
    background-color: rgb(50, 120, 255);
    color: rgb(255, 255, 255);
    font-size: 18px;
    -unity-font-style: bold;
    letter-spacing: 2px;
}

.btn-primary:hover {
    background-color: rgb(70, 140, 255);
}

.btn-primary:active {
    background-color: rgb(30, 90, 210);
}

.btn-primary:disabled {
    background-color: rgb(180, 180, 200);
    color: rgb(120, 120, 140);
}

/* ── Welcome text ───────────────────────────────────────────────── */
.welcome {
    font-size: 22px;
    color: rgb(20, 20, 60);
    -unity-text-align: middle-center;
    margin-bottom: 32px;
    white-space: normal;
}
